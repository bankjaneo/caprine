{
	"name": "caprine",
	"productName": "Caprine",
	"version": "2.62.1",
	"description": "Elegant Facebook Messenger desktop app",
	"license": "MIT",
	"repository": "bankjaneo/caprine",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"main": "dist-js",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"postinstall": "patch-package && electron-builder install-app-deps",
		"lint:xo": "xo",
		"lint:stylelint": "stylelint \"css/**/*.css\"",
		"lint": "npm run lint:xo && npm run lint:stylelint",
		"test:tsc": "npm run build",
		"test": "npm run test:tsc && npm run lint",
		"start": "tsc && electron .",
		"build": "tsc",
		"dist:linux": "electron-builder --linux",
		"dist:rpm": "bash build-rpm.sh",
		"dist:pacman": "bash build-pacman.sh",
		"dist:mac": "electron-builder --mac --x64 --arm64",
		"dist:mac:arm64": "electron-builder --mac --arm64",
		"dist:mac:x64": "electron-builder --mac --x64",
		"dist:win": "electron-builder --win",
		"release": "np --no-publish"
	},
	"dependencies": {
		"@electron/remote": "^2.1.2",
		"@sindresorhus/do-not-disturb": "^1.1.0",
		"electron-better-ipc": "^2.0.1",
		"electron-context-menu": "^3.6.1",
		"electron-debug": "^3.2.0",
		"electron-dl": "^3.5.2",
		"electron-localshortcut": "^3.2.1",
		"electron-store": "^8.1.0",
		"electron-updater": "^6.1.8",
		"electron-util": "^0.17.2",
		"element-ready": "^5.0.0",
		"facebook-locales": "^1.0.916",
		"is-online": "^12.0.2",
		"json-schema-typed": "^8.0.1",
		"lodash": "^4.17.21",
		"p-wait-for": "^3.2.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^0.7.0",
		"@types/electron-localshortcut": "^3.1.3",
		"@types/facebook-locales": "^1.0.2",
		"@types/lodash": "^4.14.202",
		"del-cli": "^8.0.1",
		"electron": "43.8.6",
		"electron-builder": "^26.18.0",
		"globals": "^17.14.0",
		"husky": "^9.0.11",
		"np": "^12.1.1",
		"npm-check-updates": "^23.1.1",
		"patch-package": "^8.0.0",
		"stylelint": "^17.16.0",
		"stylelint-config-xo": "^1.0.2",
		"typescript": "^6.0.3",
		"xo": "^5.0.1",
		"yaml": "^2.9.1"
	},
	"stylelint": {
		"extends": "stylelint-config-xo",
		"rules": {
			"declaration-no-important": null,
			"no-descending-specificity": null,
			"no-duplicate-selectors": null,
			"rule-empty-line-before": null,
			"selector-class-pattern": null,
			"selector-id-pattern": null,
			"selector-max-class": null
		}
	},
	"np": {
		"publish": false,
		"releaseDraft": false
	},
	"build": {
		"afterPack": "build/after-pack.js",
		"publish": {
			"provider": "github",
			"owner": "bankjaneo",
			"repo": "caprine"
		},
		"files": [
			"**/*",
			"!media${/*}"
		],
		"asarUnpack": [
			"static/Icon.png",
			"static/sounds/**/*"
		],
		"appId": "com.sindresorhus.caprine",
		"mac": {
			"category": "public.app-category.social-networking",
			"icon": "build/icon.icns",
			"electronUpdaterCompatibility": ">=4.5.2",
			"darkModeSupport": true,
			"target": "default",
			"extendInfo": {
				"LSUIElement": 1,
				"NSCameraUsageDescription": "Caprine needs access to your camera.",
				"NSMicrophoneUsageDescription": "Caprine needs access to your microphone."
			}
		},
		"dmg": {
			"iconSize": 160,
			"contents": [
				{
					"x": 180,
					"y": 170
				},
				{
					"x": 480,
					"y": 170,
					"type": "link",
					"path": "/Applications"
				}
			]
		},
		"linux": {
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "deb",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"icon": "build/icons/",
			"synopsis": "Elegant Facebook Messenger desktop app",
			"description": "Caprine is an unofficial and privacy focused Facebook Messenger desktop app with many useful features.",
			"category": "Network;Chat",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"snap": {
			"plugs": [
				"default",
				"camera",
				"removable-media"
			],
			"publish": [
				{
					"provider": "github"
				},
				{
					"provider": "snapStore",
					"channels": [
						"stable"
					]
				}
			]
		},
		"win": {
			"verifyUpdateCodeSignature": false,
			"icon": "build/icon.png",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		}
	},
	"husky": {
		"hooks": {
			"pre-push": "npm test"
		}
	},
	"allowScripts": {
		"electron-winstaller@5.4.0": true,
		"electron@29.4.6": true,
		"electron@43.8.6": true
	},
	"overrides": {
		"@stylistic/stylelint-plugin": "^5.3.1",
		"glob": "14.0.3",
		"global-agent": "^4.1.6",
		"katex": "^0.19.1",
		"minimatch": "11.0.4",
		"rimraf": "^6.1.3",
		"stylelint-declaration-block-no-ignored-properties": "^3.0.0",
		"stylelint-order": "^8.1.2",
		"tmp": "^0.2.7"
	}
}
